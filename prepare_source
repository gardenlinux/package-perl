pkg=perl
debian_version=5.42.2-3

version_orig=5.40.1-7
version=${version_orig}+really${debian_version}
version_suffix=gl2~bp2150

git_src -b "debian/$debian_version" "https://salsa.debian.org/perl-team/interpreter/perl.git"

# Flush changelog because we "downgrade" and recreate it
unlink $dir/src/debian/changelog

# The patches are already applied on salsa
rm -fR $dir/src/debian/patches/*
# Reapply patches here if needed, series is required for debian/rules
touch $dir/src/debian/patches/series

apply_patches
